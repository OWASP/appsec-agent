{
  "name": "appsec-agent",
  "version": "3.8.2",
  "description": "TypeScript package for AppSec AI Agent management",
  "author": "Sam Li",
  "date": "July 31 2026",
  "license": "Apache-2.0",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "conf"
  ],
  "bin": {
    "agent-run": "./dist/bin/agent-run.js"
  },
  "scripts": {
    "build": "tsc && cp -r conf dist/ && chmod +x dist/bin/agent-run.js",
    "start": "node dist/src/main.js",
    "dev": "ts-node src/main.ts",
    "clean": "rm -rf dist",
    "verify:dist": "test -x dist/bin/agent-run.js && test -f dist/src/main.js && test -f dist/conf/appsec_agent.yaml",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run clean && npm run build && npm run verify:dist && npm test"
  },
  "keywords": [
    "appsec",
    "ai-agent",
    "claude",
    "security",
    "typescript"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.141",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/codex-sdk": "0.141.0",
    "commander": "^11.1.0",
    "fs-extra": "^11.2.0",
    "openai": "^7.5.0",
    "yaml": "^2.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
